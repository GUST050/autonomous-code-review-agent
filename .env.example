# Autonomous Code Review Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM API Keys ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...      # Injection Expert, Auth Expert, Secrets Expert, Performance Expert, Fix Generator (Claude Haiku / Sonnet)
OPENAI_API_KEY=sk-...             # Code Quality Expert (GPT-4o Mini)

# ── GitHub Integration ─────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...              # Personal Access Token — required scope: repo
GITHUB_WEBHOOK_SECRET=...         # Any random string — must match the secret set on GitHub webhook

# ── LangSmith (optional — enables tracing at smith.langchain.com) ──────────────
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=autonomous-code-review
